@using System.Security.Claims
@{
    ViewData["Title"] = "Inicio";
    var currentUser = User.FindFirstValue(ClaimTypes.GivenName) ?? User.Identity?.Name;
    var currentRole = User.FindFirstValue(ClaimTypes.Role);
}

<section class="store-hero">
    <div class="store-hero-copy">
        <span class="eyebrow">Mercado Nativa</span>
        <h1>Compra rapido, elige mejor y mantente al dia con lo que mas se mueve.</h1>
        <p>
            Un minimarket digital pensado para vender con claridad, mostrar productos con buena presencia y darle al cliente una experiencia simple desde el primer vistazo.
        </p>
        <div class="hero-actions">
            <a class="btn btn-dark btn-lg" asp-controller="Catalog" asp-action="Index">Comprar ahora</a>
            <a class="btn btn-outline-dark btn-lg" asp-controller="Contact" asp-action="Index">Hablar con tienda</a>
            <a class="btn btn-outline-success btn-lg" asp-controller="Cart" asp-action="Index">Ver carrito</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="btn btn-outline-dark btn-lg" asp-controller="Session" asp-action="Index">Mi cuenta</a>
            }
            else
            {
                <a class="btn btn-success btn-lg" asp-controller="Auth" asp-action="Login">Ingresar</a>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(currentUser))
        {
            <div class="session-banner">
                <strong>@currentUser</strong>
                <span>@currentRole</span>
            </div>
        }
    </div>

    <div class="store-hero-panel">
        <div class="store-panel-top">
            <span class="status-pill">Abierto hoy</span>
            <span class="status-pill">Entrega rapida</span>
        </div>
        <div class="store-price-block">
            <span>Canasta destacada</span>
            <strong>S/ 39.90</strong>
            <p>Seleccion pensada para compras frecuentes y rotacion diaria.</p>
        </div>
        <div class="store-mini-grid">
            <article>
                <span>Snacks</span>
                <strong>+120</strong>
            </article>
            <article>
                <span>Bebidas</span>
                <strong>+80</strong>
            </article>
            <article>
                <span>Favoritos</span>
                <strong>Top ventas</strong>
            </article>
            <article>
                <span>Compra guiada</span>
                <strong>Recomendaciones</strong>
            </article>
        </div>
    </div>
</section>

<section class="business-strip">
    <article>
        <span>Atencion clara</span>
        <strong>Compra sin vueltas</strong>
    </article>
    <article>
        <span>Inventario visible</span>
        <strong>Stock actualizado</strong>
    </article>
    <article>
        <span>Movimiento comercial</span>
        <strong>Tendencias utiles</strong>
    </article>
</section>

<section class="home-section">
    <div class="section-heading section-heading-inline">
        <div>
            <span class="eyebrow">Seleccion del dia</span>
            <h2>Todo lo importante, sin ruido</h2>
        </div>
        <a class="btn btn-outline-dark" asp-controller="Catalog" asp-action="Index">Ver catalogo completo</a>
    </div>

    <div class="store-card-grid">
        <article class="store-card store-card-primary">
            <h3>Productos listos para comprar</h3>
            <p>Encuentra categorias claras, precios visibles y una ruta de compra directa.</p>
        </article>
        <article class="store-card">
            <h3>Sugerencias que empujan venta</h3>
            <p>La tienda destaca combinaciones utiles para aumentar ticket promedio.</p>
        </article>
        <article class="store-card">
            <h3>Lectura rapida del negocio</h3>
            <p>El comportamiento de ventas ayuda a decidir que mover primero.</p>
        </article>
    </div>
</section>

<section class="home-section accent-section">
    <div class="section-heading">
        <span class="eyebrow">Experiencia de compra</span>
        <h2>Una tienda mas ordenada y con mejor presencia</h2>
    </div>

    <div class="store-showcase">
        <article class="showcase-quote">
            <p>
                "La pagina debe verse como negocio: limpia, directa y con foco en vender, no en explicar internamente como fue construida."
            </p>
        </article>
        <article class="showcase-actions">
            <a class="btn btn-dark" asp-controller="Recommendation" asp-action="Index">Ver sugerencias</a>
            <a class="btn btn-outline-dark" asp-controller="Forecast" asp-action="Index">Ver tendencias</a>
            <a class="btn btn-outline-dark" asp-controller="Contact" asp-action="Index">Solicitar apoyo</a>
        </article>
    </div>
</section>