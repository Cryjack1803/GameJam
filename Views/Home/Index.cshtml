                    <li>Fecha: 15 de Abril, 2026</li>
                    <li>Lugar: Online</li>
                    <li>Inscripción: Abierta</li>
                </ul>
                <a href="/GameJam/Register" class="btn btn-success btn-lg mt-3">
                    <i class="fa fa-user-plus"></i> Registrar Jugador
                </a>
            </div>
        </div>
    </div>