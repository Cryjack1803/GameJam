@{
    ViewData["Title"] = "GameJam 2026";
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2><i class="fa fa-gamepad"></i> Bienvenido al GameJam 2026</h2>
        </div>
        <div class="card-body">
            <p class="lead">¡Participa en el evento más grande de desarrollo de videojuegos! Regístrate, comparte tus
