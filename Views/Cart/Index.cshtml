@model Tarea_01.Models.CartViewModel

@{
    ViewData["Title"] = "Carrito y ventas";
}

<section class="cart-shell">
    <div class="cart-card">
        <span class="eyebrow">HU 07</span>
        <h1 class="mt-3">Carrito y ventas</h1>
        <p class="message-meta mb-0">
            Este modulo usa sesion para el carrito y registra ventas locales descontando stock del inventario compartido.
        </p>
    </div>

    @if (TempData["CartMessage"] is string notice)
    {
        <div class="alert alert-success mb-0">@notice</div>
    }

    <div class="cart-layout">
        <article class="cart-card">
            <h2 class="h3">Tu carrito</h2>

            @if (Model.Items.Any())
            {
                <div class="cart-table-wrapper mt-3">
                    <table class="table table-hover cart-table mb-0">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Cantidad</th>
                                <th>Precio unitario</th>
                                <th>Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td>@item.Quantity</td>
                                    <td>S/ @item.UnitPrice.ToString("0.00")</td>
                                    <td>S/ @item.Subtotal.ToString("0.00")</td>
                                    <td>
                                        <form asp-action="Remove" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Quitar</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="catalog-empty mt-3">No hay productos en el carrito.</div>
            }
        </article>

        <aside class="cart-summary">
            <h2 class="h3">Resumen</h2>
            <span class="cart-total">S/ @Model.Total.ToString("0.00")</span>
            <p class="message-meta mt-3">
                Completa la compra para registrar la venta y descontar el stock del inventario.
            </p>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <form asp-action="Checkout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-dark" @(Model.Items.Any() ? null : "disabled")>Confirmar compra</button>
                </form>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-dark">Seguir comprando</a>
            </div>
        </aside>
    </div>

    <article class="cart-card">
        <h2 class="h3">Ventas recientes</h2>

        @if (Model.RecentSales.Any())
        {
            <div class="sales-list mt-3">
                @foreach (var sale in Model.RecentSales)
                {
                    <article class="sale-card">
                        <div class="catalog-badges">
                            <span class="status-pill">Venta #@sale.Id</span>
                            <span class="status-pill">@sale.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <h3 class="h5 mt-3">@sale.BuyerName</h3>
                        <p class="message-meta mb-2">Total: S/ @sale.Total.ToString("0.00")</p>
                        <ul class="mb-0">
                            @foreach (var item in sale.Items)
                            {
                                <li>@item.ProductName x @item.Quantity</li>
                            }
                        </ul>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="catalog-empty mt-3">Aun no hay ventas registradas.</div>
        }
    </article>
</section>