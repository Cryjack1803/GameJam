@model Tarea_01.Models.GameJamViewModel

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4><i class="fa fa-user-plus"></i> Registro de GameJam</h4>
        </div>
        <div class="card-body">
            <form asp-action="Register">
                <div class="row">
                    <!-- Información Personal -->
                    <div class="col-md-6">
                        <h5>Información Personal</h5>
                        <div class="form-group mb-3">
                            <label>Nombre del Jugador</label>
                            <input asp-for="Nombre" class="form-control" />
                        </div>
                        <div class="form-group mb-3">
                            <label>Fecha de Nacimiento</label>
                            <input asp-for="FechaNacimiento" type="date" class="form-control" min="1950-01-01" />
                        </div>
                        <div class="form-group mb-3">
                            <label>Hobbies</label>
                            <input asp-for="Hobbies" class="form-control" />
                        </div>
                    </div>
                    <!-- Información de Registro -->
                    <div class="col-md-6">
                        <h5>Registro</h5>
                        <div class="form-group mb-3">
                            <label>Pago de Matrícula</label>
                            <select asp-for="PagoMatricula" class="form-control">
                                <option value="">Seleccione...</option>
                                <option value="true">Sí</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                        @if (Model.PagoMatricula == false)
                        {
                            <div class="alert alert-danger mt-2">
                                Ud. aún no ha completado su pago.
                            </div>
                        }
                        @if (Model.PagoMatricula == true)
                        {
                            <div class="alert alert-success mt-2">
                                Registro completado.
                            </div>
                        }
                    </div>
                </div>
                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-check"></i> Registrar Jugador
                    </button>
                    <a href="/" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>