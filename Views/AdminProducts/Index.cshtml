@model IEnumerable<Tarea_01.Models.ProductViewModel>

@{
    ViewData["Title"] = "Administrar productos";
}

<section class="admin-shell">
    <div class="admin-toolbar">
        <div>
            <span class="eyebrow">HU 06</span>
            <h1 class="mt-3 mb-0">Administracion de productos</h1>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Create" class="btn btn-dark">Nuevo producto</a>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-dark">Ver catalogo</a>
        </div>
    </div>

    @if (TempData["AdminProductMessage"] is string notice)
    {
        <div class="alert alert-success mb-0">@notice</div>
    }

    <article class="admin-card">
        <div class="admin-table-wrapper">
            <table class="table table-hover admin-table mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Categoria</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Unidad</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                <strong>@product.Name</strong>
                                <div class="message-meta">@product.Description</div>
                            </td>
                            <td>@product.Category</td>
                            <td>S/ @product.Price.ToString("0.00")</td>
                            <td>@product.Stock</td>
                            <td>@product.Unit</td>
                            <td>
                                @if (product.IsFeatured)
                                {
                                    <span class="status-pill">Destacado</span>
                                }
                                else
                                {
                                    <span class="status-pill">Normal</span>
                                }
                            </td>
                            <td>
                                <div class="admin-actions">
                                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-dark btn-sm">Editar</a>
                                    <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </article>
</section>