@model Tarea_01.Models.AgentViewModel

@{
    ViewData["Title"] = "Asistente IA";
}

<section class="agent-shell">
    <div class="agent-card">
        <span class="eyebrow">IA Agent</span>
        <h1 class="mt-3">Asistente Inteligente del minimarket</h1>
        <p class="message-meta mb-0">
            Este módulo simula un agente IA que analiza inventario, ventas y tendencias para ayudarte a tomar decisiones comerciales.
        </p>
    </div>

    <div class="agent-layout">
        <article class="agent-card">
            <h2 class="h3">Pregunta al agente</h2>
            <form asp-action="Ask" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label for="query" class="form-label">¿En qué puedo ayudarte?</label>
                    <textarea id="query" name="Query" rows="4" class="form-control">@Model.Query</textarea>
                </div>
                <button type="submit" class="btn btn-dark">Enviar pregunta</button>
            </form>
        </article>

        <aside class="agent-summary">
            <h2 class="h3">Respuesta del agente</h2>
            <pre class="agent-response">@Model.Response</pre>
        </aside>
    </div>
</section>
