@model Tarea_01.Models.CatalogViewModel

@{
    ViewData["Title"] = "Catalogo";
}

<section class="catalog-shell">
    <div class="catalog-hero">
        <span class="eyebrow">HU 03</span>
        <h1 class="mt-3">Catalogo del minimarket</h1>
        <p class="catalog-meta mb-0">
            Este modulo presenta productos, categorias, precios y stock actual para cubrir el avance de catalogo.
        </p>
    </div>

    <div class="catalog-filter">
        <form method="get" class="catalog-filter-form">
            <div>
                <label class="form-label" for="search">Buscar producto</label>
                <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Arroz, leche, detergente..." />
            </div>
            <div>
                <label class="form-label" for="category">Categoria</label>
                <select id="category" name="category" class="form-select">
                    <option value="">Todas</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category" selected="@(Model.Category == category)">@category</option>
                    }
                </select>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark">Filtrar</button>
                <a asp-action="Index" class="btn btn-outline-dark">Limpiar</a>
            </div>
        </form>
    </div>

    @if (Model.Products.Any())
    {
        <div class="catalog-grid">
            @foreach (var product in Model.Products)
            {
                <article class="catalog-card">
                    <div class="catalog-badges">
                        <span class="eyebrow">@product.Category</span>
                        @if (product.IsFeatured)
                        {
                            <span class="status-pill">Destacado</span>
                        }
                    </div>

                    <h3>@product.Name</h3>
                    <p class="catalog-meta">@product.Description</p>
                    <span class="catalog-price">S/ @product.Price.ToString("0.00")</span>

                    <div class="catalog-card-footer">
                        <span class="catalog-stock @(product.Stock <= 8 ? "low" : string.Empty)">
                            Stock: @product.Stock @product.Unit
                        </span>
                        <div class="d-flex flex-wrap gap-2 justify-content-end">
                            <a asp-action="Detail" asp-route-id="@product.Id" class="btn btn-outline-dark btn-sm">Ver detalle</a>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <button type="submit" class="btn btn-dark btn-sm" @(product.Stock == 0 ? "disabled" : null)>Agregar</button>
                                </form>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="catalog-empty">
            No se encontraron productos con los filtros actuales.
        </div>
    }
</section>