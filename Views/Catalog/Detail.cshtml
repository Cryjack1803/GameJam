@model Tarea_01.Models.CatalogDetailViewModel

@{
    ViewData["Title"] = "Detalle de producto";
}

<section class="catalog-shell">
    <div class="catalog-detail-layout">
        <article class="catalog-detail-main">
            <div class="catalog-badges">
                <span class="eyebrow">@Model.Product.Category</span>
                @if (Model.Product.IsFeatured)
                {
                    <span class="status-pill">Producto destacado</span>
                }
            </div>

            <h1>@Model.Product.Name</h1>
            <p>@Model.Product.Description</p>
            <span class="catalog-price">S/ @Model.Product.Price.ToString("0.00")</span>
        </article>

        <aside class="catalog-detail-side">
            <h2 class="h4">Resumen comercial</h2>
            <ul>
                <li>Categoria: @Model.Product.Category</li>
                <li>Unidad de venta: @Model.Product.Unit</li>
                <li>Stock actual: @Model.Product.Stock</li>
                <li>Estado: @(Model.Product.Stock <= 8 ? "Reposicion sugerida" : "Disponible")</li>
            </ul>

            <div class="d-flex flex-wrap gap-2 mt-4">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.Product.Id" />
                        <button type="submit" class="btn btn-dark" @(Model.Product.Stock == 0 ? "disabled" : null)>Agregar al carrito</button>
                    </form>
                }
                <a asp-action="Index" class="btn btn-dark">Volver al catalogo</a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">Ir al inicio</a>
            </div>
        </aside>
    </div>

    <article class="catalog-filter">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <span class="eyebrow">Recomendaciones</span>
                <h2 class="h3 mt-3 mb-0">Productos sugeridos</h2>
            </div>
            <a asp-controller="Recommendation" asp-action="Index" class="btn btn-outline-dark">Ver panel completo</a>
        </div>

        @if (Model.Recommendations.Any())
        {
            <div class="catalog-grid mt-4">
                @foreach (var recommendation in Model.Recommendations)
                {
                    <article class="catalog-card recommendation-card">
                        <div class="catalog-badges">
                            <span class="eyebrow">@recommendation.Product.Category</span>
                            <span class="status-pill">@recommendation.Reason</span>
                        </div>
                        <h3>@recommendation.Product.Name</h3>
                        <p class="catalog-meta">@recommendation.Product.Description</p>
                        <span class="catalog-price">S/ @recommendation.Product.Price.ToString("0.00")</span>
                        <div class="catalog-card-footer">
                            <span class="catalog-stock">Afinidad: @recommendation.Score.ToString("0.0")</span>
                            <a asp-action="Detail" asp-route-id="@recommendation.Product.Id" class="btn btn-outline-dark btn-sm">Ver</a>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="catalog-empty mt-4">Aun no hay suficientes datos para recomendar productos relacionados.</div>
        }
    </article>
</section>