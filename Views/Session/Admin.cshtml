@{
    ViewData["Title"] = "Sesion de administrador";
}

<section class="session-shell">
    <div class="session-card">
        <span class="eyebrow">Administrador</span>
        <h1 class="mt-3">Zona restringida por rol</h1>
        <p class="message-meta">
            Solo los usuarios con rol Administrador pueden entrar aqui. Esta vista sirve para demostrar control de acceso.
        </p>

        <div class="session-badges">
            <span class="status-pill">Acceso valido</span>
            <span class="status-pill">Rol requerido: Administrador</span>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <a asp-action="Index" class="btn btn-dark">Volver al panel de sesion</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">Inicio</a>
        </div>
    </div>
</section>