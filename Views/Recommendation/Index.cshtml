@model IEnumerable<Tarea_01.Models.ProductRecommendationViewModel>

@{
    ViewData["Title"] = "Recomendaciones";
}

<section class="recommendation-shell">
    <div class="forecast-card">
        <span class="eyebrow">HU 10</span>
        <h1 class="mt-3">Recomendacion de productos</h1>
        <p class="message-meta mb-0">
            Este modulo sugiere productos por co-compra, rotacion y cercania de categoria usando el historial actual de ventas.
        </p>
    </div>

    <div class="recommendation-grid">
        @foreach (var recommendation in Model)
        {
            <article class="catalog-card recommendation-card">
                <div class="catalog-badges">
                    <span class="eyebrow">@recommendation.Product.Category</span>
                    <span class="status-pill">@recommendation.Reason</span>
                </div>
                <h3>@recommendation.Product.Name</h3>
                <p class="catalog-meta">@recommendation.Product.Description</p>
                <span class="catalog-price">S/ @recommendation.Product.Price.ToString("0.00")</span>
                <div class="catalog-card-footer">
                    <span class="catalog-stock">Puntaje: @recommendation.Score.ToString("0.0")</span>
                    <a asp-controller="Catalog" asp-action="Detail" asp-route-id="@recommendation.Product.Id" class="btn btn-outline-dark btn-sm">Ver detalle</a>
                </div>
            </article>
        }
    </div>
</section>