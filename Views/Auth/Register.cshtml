@model Tarea_01.Models.RegisterViewModel

@{
    ViewData["Title"] = "Registro";
}

<section class="auth-shell">
    <div class="auth-card">
        <span class="eyebrow">Identity</span>
        <h1 class="mt-3">Crear cuenta</h1>
        <p class="text-secondary">
            Registra un nuevo usuario del minimarket. La cuenta se guarda en SQLite con Identity y entra
            con rol Cliente por defecto.
        </p>

        <form asp-action="Register" method="post" class="mt-4">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control form-control-lg" placeholder="Ingresa tu nombre" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control form-control-lg" placeholder="usuario@minimarket.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control form-control-lg" placeholder="Crea una contrasena segura" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control form-control-lg" placeholder="Repite la contrasena" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-dark btn-lg">Crear cuenta</button>
                <a asp-action="Login" class="btn btn-success btn-lg">Ya tengo cuenta</a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark btn-lg">Volver al inicio</a>
            </div>
        </form>
    </div>

    <aside class="auth-side">
        <span class="status-pill">Roles iniciales</span>
        <h2 class="mt-3">Que queda listo con este cambio</h2>
        <div class="credential-list">
            <article class="credential-item">
                <strong>Administrador inicial</strong>
                <span>Correo: admin@minimarket.com</span>
                <span>Clave: Admin123*</span>
            </article>
            <article class="credential-item">
                <strong>Roles sembrados</strong>
                <span>Administrador, Cliente y Cajero.</span>
                <span>Los nuevos registros entran como Cliente.</span>
            </article>
            <article class="credential-item">
                <strong>Persistencia</strong>
                <span>Identity usa SQLite para guardar usuarios y credenciales.</span>
            </article>
        </div>
    </aside>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}