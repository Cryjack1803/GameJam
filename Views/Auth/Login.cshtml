@model Tarea_01.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<section class="auth-shell">
    <div class="auth-card">
        <span class="eyebrow">HU 02</span>
        <h1 class="mt-3">Ingreso al sistema</h1>
        <p class="text-secondary">
            Esta pantalla cubre el acceso inicial del minimarket y deja lista la base para sesiones,
            roles y futuras validaciones con base de datos.
        </p>

        <form asp-action="Login" method="post" class="mt-4">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control form-control-lg" placeholder="usuario@minimarket.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control form-control-lg" placeholder="Ingresa tu contrasena" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-dark btn-lg">Ingresar</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark btn-lg">Volver al inicio</a>
            </div>
        </form>
    </div>

    <aside class="auth-side">
        <span class="status-pill">Accesos de prueba</span>
        <h2 class="mt-3">Credenciales demo para la sustentacion</h2>
        <p class="text-secondary">
            Puedes usar cualquiera de estos accesos para demostrar roles hasta que la HU de base de datos
            reemplace este login temporal.
        </p>

        <div class="credential-list">
            <article class="credential-item">
                <strong>Administrador</strong>
                <span>Correo: admin@minimarket.com</span>
                <span>Clave: Admin123*</span>
            </article>
            <article class="credential-item">
                <strong>Cliente</strong>
                <span>Correo: cliente@minimarket.com</span>
                <span>Clave: Cliente123*</span>
            </article>
            <article class="credential-item">
                <strong>Cajero</strong>
                <span>Correo: cajero@minimarket.com</span>
                <span>Clave: Cajero123*</span>
            </article>
        </div>
    </aside>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}